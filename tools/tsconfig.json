{
  "//": "回归编译(只编 core/** + tools/**,外加 ui 下三个零 cc 依赖的纯函数文件:text-metrics / release-notes / editor-strip,更新弹窗的折行与编辑器顶栏的排版都要在 node 下断言)。core/update-service.ts 直接用 XMLHttpRequest,故 lib 带 DOM,与 tsconfig.check.json 一致。",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "../.tools-build",
    "rootDir": "..",
    "lib": ["ES2020", "DOM"],
    "types": ["node"]
  },
  "include": [
    "./**/*.ts",
    "../assets/scripts/core/**/*.ts",
    "../assets/scripts/ui/text-metrics.ts",
    "../assets/scripts/ui/release-notes.ts",
    "../assets/scripts/ui/editor-strip.ts"
  ]
}
