{
  "//": "回归编译(只编 core/** + tools/**)。core/update-service.ts 直接用 XMLHttpRequest,故 lib 带 DOM,与 tsconfig.check.json 一致。",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "../.tools-build",
    "rootDir": "..",
    "lib": ["ES2020", "DOM"],
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../assets/scripts/core/**/*.ts"]
}
