{
  "//": "拿引擎真类型复查:temp/declarations/cc.d.ts → CocosCreator.app 内的 cc.d.ts。项目 memory 要求改过 cc 触摸/坐标 API 后跑一遍。",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2020", "DOM"],
    "types": []
  },
  "include": ["../assets/scripts/**/*.ts"],
  "files": [
    "/Applications/CocosCreator.app/Contents/Resources/resources/3d/engine/bin/.declarations/cc.d.ts"
  ]
}
