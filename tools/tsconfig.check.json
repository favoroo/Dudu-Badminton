{
  "//": "assets/scripts 全量类型检查(shim 兜底 cc 类型,编辑器打开后以正式类型为准)",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2020", "DOM"],
    "types": ["node"]
  },
  "include": ["../assets/scripts/**/*.ts", "./cc-shim.d.ts"]
}
