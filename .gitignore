# Cocos Creator 生成/缓存目录 —— 只提交源文件
/library/
/temp/
/local/
/build/
/profiles/
/extensions/**/node_modules/

# 回归工具的编译产物与依赖
.tools-build/
node_modules/

# 部署时的 gh-pages 临时 worktree(tools/deploy-site.py 用完即删)
.gh-pages-work/

# 宣传片中间产物(逐帧 PNG 序列 / 成片,体积大且可重出)
.promo/

# 编辑器与代理工具缓存
.trae/
.zcode/
.workbuddy/
.clawhub/
vibe_images/

# Agent 变更日志(仅本地追踪,规范见 AGENTS.md「变更日志」)
CHANGELOG.md

# 根目录一次性调试脚本(不入库)
/test_*.js

# 系统文件
.DS_Store

# 正式签名密钥与口令 —— 绝不入库(丢了 keystore+口令 = 老用户永远收不到更新)
/keystore/
